# ── SSH Key Pair ─────────────────────────────────────────────────────────────
resource "tls_private_key" "range" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "range" {
  key_name   = "${var.target_name}-key"
  public_key = tls_private_key.range.public_key_openssh
}

resource "local_sensitive_file" "private_key" {
  content         = tls_private_key.range.private_key_pem
  filename        = "${path.module}/${var.target_name}.pem"
  file_permission = "0600"
}

# ── AMI — Ubuntu 22.04 LTS ───────────────────────────────────────────────────
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# ── EC2 Instance ─────────────────────────────────────────────────────────────
resource "aws_instance" "target" {
  ami                    = data.aws_ami.ubuntu.id
  instance_type          = var.instance_type
  subnet_id              = aws_subnet.public.id
  vpc_security_group_ids = [aws_security_group.target.id]
  key_name               = aws_key_pair.range.key_name

  root_block_device {
    volume_size = 30
    volume_type = "gp3"
  }

  user_data = base64encode(templatefile("${path.module}/scripts/install.sh", {}))

  tags = { Name = var.target_name }
}
